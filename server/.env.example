# Copy to server/.env and fill in.

PORT=8787

# Shown in our User-Agent so store owners can reach you. Use a URL or email you own.
BOT_CONTACT=https://your-site.example/bot

# Tuning (defaults shown)
# ADAPTER_TIMEOUT_MS=6000
# CACHE_TTL_MS=1800000
# RATE_LIMIT_CONCURRENCY=2
# RATE_LIMIT_MIN_GAP_MS=400
# RESPECT_ROBOTS_TXT=true

# Serve captured store responses instead of hitting the network (tests/demos).
# USE_FIXTURES=1

# ── Game Nation ─────────────────────────────────────────────────────────────
# Its search API is private and client-side. Open
#   https://www.gamenation.in/searchresults?q=god%20of%20war
# in Chrome, DevTools > Network > Fetch/XHR, find the request that returns the
# product list, and paste its URL here with {q} where the search text goes.
GAMENATION_SEARCH_URL=

# ── PHASE 2 (not used yet) ──────────────────────────────────────────────────
# Amazon Product Advertising API 5.0 — requires an approved Amazon Associates account
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=

# Flipkart Affiliate API
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
